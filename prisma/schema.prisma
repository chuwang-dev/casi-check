// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  profile   Profile?
}

model Profile {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  graduationYear Int
  degree         String?
  major          String?
  user           User     @relation(fields: [userId], references: [id])
  userId         String   @unique
}
